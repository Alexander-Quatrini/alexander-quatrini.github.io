---
import SectionWrapper from '../ui/SectionWrapper.astro';
import { skills } from '../../data/resume';

const techSkills = skills.filter(g => g.category !== 'Soft Skills');
const softSkills = skills.filter(g => g.category === 'Soft Skills');
---

<SectionWrapper id="skills" title="Skills" surface>
  <div class="flex flex-col gap-8">

    <!-- Technical Skills -->
    <div class="flex flex-col gap-5">
      <h3 class="text-sm font-semibold text-accent uppercase tracking-widest">Technical</h3>
      {techSkills.map(group => (
        <div class="flex flex-col sm:flex-row gap-2 sm:gap-8 border-l-2 border-accent/40 pl-5">
          <span class="text-text-muted text-sm font-semibold shrink-0 sm:w-36">{group.category}</span>
          <span class="text-text-primary text-sm leading-relaxed">{group.items.join('  ·  ')}</span>
        </div>
      ))}
    </div>

    <!-- Divider -->
    {softSkills.length > 0 && <hr class="border-border" />}

    <!-- Soft Skills -->
    {softSkills.length > 0 && (
      <div class="flex flex-col gap-5">
        <h3 class="text-sm font-semibold text-accent uppercase tracking-widest">Soft Skills</h3>
        {softSkills.map(group => (
          <div class="flex flex-col sm:flex-row gap-2 sm:gap-8 border-l-2 border-accent/40 pl-5">
            <span class="text-text-primary text-sm leading-relaxed">{group.items.join('  ·  ')}</span>
          </div>
        ))}
      </div>
    )}
  </div>
</SectionWrapper>
