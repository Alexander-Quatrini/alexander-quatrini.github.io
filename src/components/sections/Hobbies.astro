---
import SectionWrapper from '../ui/SectionWrapper.astro';
import { hobbies } from '../../data/resume';
---

<SectionWrapper id="hobbies" title="Hobbies & Interests" surface>
  <div class="flex flex-col gap-6">
    {hobbies.map(hobby => (
      <div class="border border-border bg-bg-elevated p-6 hover:border-accent/40 transition-colors duration-200">
        <!-- Header -->
        <div class="flex items-center gap-3 mb-3">
          <span class="text-2xl" role="img" aria-label={hobby.label}>{hobby.icon}</span>
          <h3 class="text-lg font-semibold text-text-primary">{hobby.label}</h3>
        </div>

        <!-- Description -->
        <p class="text-text-muted text-sm leading-relaxed mb-5">{hobby.description}</p>

        <!-- Transferable skills -->
        <div class="border-l-2 border-accent/40 pl-4">
          <p class="text-xs font-semibold text-accent uppercase tracking-widest mb-2">Transferable Skills</p>
          <p class="text-text-muted text-sm">{hobby.transferableSkills.join('  ·  ')}</p>
        </div>
      </div>
    ))}
  </div>
</SectionWrapper>
