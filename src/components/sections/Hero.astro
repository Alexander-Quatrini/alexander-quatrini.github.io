---
import { heroData } from '../../data/resume';
---

<section class="min-h-screen bg-bg-base flex items-center justify-center px-4 sm:px-6">
  <div class="max-w-3xl w-full text-center flex flex-col items-center gap-6">

    <!-- Photo placeholder -->
    <div class="w-32 h-32 flex items-center justify-center select-none">
      <img class="rounded-full" src="head-shot.jpg">
    </div>

    <!-- Name -->
    <h1 class="text-5xl sm:text-6xl font-bold text-text-primary tracking-tight">
      {heroData.name}
    </h1>

    <!-- Title -->
    <p class="text-xl sm:text-2xl text-accent font-medium">
      {heroData.title}
    </p>

    <!-- Tagline -->
    <p class="text-text-muted text-base sm:text-lg leading-relaxed max-w-xl">
      {heroData.tagline}
    </p>

    <!-- CTA buttons -->
    <div class="flex flex-col sm:flex-row gap-3 mt-2">
      <!-- <a
        href={heroData.ctaPrimary.href}
        class="px-6 py-3 bg-accent text-bg-base font-semibold text-sm hover:bg-accent-dim transition-colors duration-200"
      >
        {heroData.ctaPrimary.label}
      </a> -->
      <a
        href={heroData.ctaSecondary.href}
        class="px-6 py-3 border border-accent text-accent font-semibold text-sm hover:bg-accent/10 transition-colors duration-200"
      >
        {heroData.ctaSecondary.label}
      </a>
    </div>

    <!-- Scroll hint -->
    <div class="mt-8 text-text-muted animate-bounce">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </div>
</section>
