---
import SectionWrapper from '../ui/SectionWrapper.astro';
import { builtWithAI } from '../../data/resume';
---

<SectionWrapper id="built-with-ai" title="Built with AI">
  <div class="flex flex-col gap-8">

    <!-- Intro paragraph -->
    <p class="text-text-muted text-sm leading-relaxed max-w-3xl">{builtWithAI.intro}</p>

    <!-- Detail points -->
    <div class="flex flex-col gap-4">
      {builtWithAI.points.map(point => (
        <div class="border border-border bg-bg-surface p-6 hover:border-accent/40 transition-colors duration-200">
          <h3 class="text-base font-semibold text-text-primary mb-2">{point.heading}</h3>
          <p class="text-text-muted text-sm leading-relaxed">{point.body}</p>
        </div>
      ))}
    </div>

    <!-- Tech used -->
    <div class="border-l-2 border-accent/40 pl-4">
      <p class="text-xs font-semibold text-accent uppercase tracking-widest mb-2">Tech Used</p>
      <p class="text-text-muted text-sm">{builtWithAI.techUsed.join('  ·  ')}</p>
    </div>
  </div>
</SectionWrapper>
