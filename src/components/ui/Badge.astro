---
interface Props {
  label: string;
  variant?: 'default' | 'accent';
}

const { label, variant = 'default' } = Astro.props;
---

<span
  class:list={[
    'inline-block px-2.5 py-0.5 text-xs font-medium border',
    variant === 'accent'
      ? 'bg-accent/10 text-accent border-accent/30'
      : 'bg-bg-elevated text-text-muted border-border',
  ]}
>
  {label}
</span>
